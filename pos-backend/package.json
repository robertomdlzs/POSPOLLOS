{
  "name": "pos-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend del POS para restaurantes (NestJS + PostgreSQL)",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "db:migrar": "node scripts/migrar.mjs",
    "db:semilla": "node scripts/semilla.mjs",
    "test:flujo": "node tests/flujo.e2e.mjs",
