JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-48-bytes
PORT=3000
CORS_ORIGINS=http://localhost:5173
ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=7
